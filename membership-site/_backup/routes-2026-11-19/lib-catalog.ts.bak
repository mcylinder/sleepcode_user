import sessionsData from '@/data/sessions.json';

// Each session's audio lives under session/{voiceId}/{sessionId}/ in the media bucket.
export interface Voice {
  id: string;
  name: string;
  description: string;
}

export interface Session {
  id: string;
  title: string;
  theme: string;
  description: string;
  free: boolean;
}

interface SessionsDocument {
  voices: Voice[];
  sessions: Session[];
}

const document = sessionsData as SessionsDocument;

export const VOICES: Voice[] = document.voices ?? [];
export const SESSIONS: Session[] = document.sessions ?? [];

// Library filter chips — category order from sleepcode-content (catalog_theme).
export const THEMES: string[] = [
  'Mindset',
  'Drive',
  'Self',
  'Ease',
  'Connection',
  'Body',
  'Growth',
  'Freedom',
];

/** Multi-part series from ids like `first-date-part-1`. */
export function sessionPartInfo(session: Session): { part: number; of: number } | null {
  const match = /-part-(\d+)$/i.exec(session.id);
  if (!match) return null;
  const part = Number(match[1]);
  const of = SESSIONS.filter(
    (other) => other.title === session.title && other.theme === session.theme && /-part-\d+$/i.test(other.id),
  ).length;
  if (of < 2) return null;
  return { part, of };
}

// Second line under a session title: its collection, or "Part 1 of 4" for a series.
export function sessionSubtitle(session: Session): string {
  const parts = sessionPartInfo(session);
  return parts ? `Part ${parts.part} of ${parts.of}` : session.theme;
}

// The separator between a title and its collection: a middle dot with en spaces, so it
// doesn't crowd the words in Instrument Sans.
export const SEP = '\u2002\u00b7\u2002';

// Display name: "Open Door · Optimism", or "First Date · Part 1 of 4" for series.
export function sessionLabel(session: Session): string {
  const parts = sessionPartInfo(session);
  if (parts) return `${session.title}${SEP}Part ${parts.part} of ${parts.of}`;
  return `${session.title}${SEP}${session.theme}`;
}

/** Paid sessions require an active SleepCode+ membership to play. */
export function needsMembership(session: Session): boolean {
  return !session.free;
}

export function scriptHref(session: Session): string {
  return `/sessions/${encodeURIComponent(session.id)}`;
}

// The session the marketing pages offer to play for free.
export const FEATURED_FREE_SESSION: Session | null = SESSIONS.find((session) => session.free) ?? null;

export const MEMBER_ONLY_COUNT = SESSIONS.filter((session) => !session.free).length;

export function findSession(id: string | null | undefined): Session | null {
  return SESSIONS.find((session) => session.id === id) ?? null;
}

export function findVoice(id: string | null | undefined): Voice | null {
  return VOICES.find((voice) => voice.id === id) ?? null;
}

/** Pref voice if still in the catalog; otherwise null. */
export function resolveVoiceId(preferred: string | null | undefined): string | null {
  return findVoice(preferred)?.id ?? null;
}

/** For surfaces without a picker (home sample, transcript): pref or first catalog voice. */
export function mediaVoiceId(preferred: string | null | undefined): string | null {
  return resolveVoiceId(preferred) ?? VOICES[0]?.id ?? null;
}

export function playerHref(session: Session): string {
  return `/application/player?session=${encodeURIComponent(session.id)}`;
}

export function moreSessionsLabel(count: number): string {
  return `${count} more ${count === 1 ? 'session' : 'sessions'}`;
}

const LAST_SESSION_KEY = 'sleepcode_last_session';
const RECENT_SESSIONS_KEY = 'sleepcode_recent_sessions';
const RECENT_KEEP = 5;

export interface LastPlayed {
  session: Session;
  playedAt: Date | null;
}

type StoredPlay = { id?: string; at?: number };

function parseStoredPlay(raw: string): StoredPlay | null {
  try {
    // Older entries stored only the session id.
    return raw.startsWith('{') ? (JSON.parse(raw) as StoredPlay) : { id: raw };
  } catch {
    return null;
  }
}

function entryFromStored(parsed: StoredPlay | null): LastPlayed | null {
  const session = findSession(parsed?.id);
  if (!session) return null;
  return { session, playedAt: typeof parsed?.at === 'number' ? new Date(parsed.at) : null };
}

export function loadLastPlayed(): LastPlayed | null {
  if (typeof window === 'undefined') return null;
  try {
    const raw = localStorage.getItem(LAST_SESSION_KEY);
    if (!raw) return null;
    return entryFromStored(parseStoredPlay(raw));
  } catch {
    return null;
  }
}

/** Most-recent first, distinct sessions (up to RECENT_KEEP). Seeds from last-played if empty. */
export function loadRecentlyPlayed(): LastPlayed[] {
  if (typeof window === 'undefined') return [];
  try {
    const raw = localStorage.getItem(RECENT_SESSIONS_KEY);
    const entries: LastPlayed[] = [];
    if (raw) {
      const parsed = JSON.parse(raw) as unknown;
      if (Array.isArray(parsed)) {
        for (const item of parsed) {
          const entry = entryFromStored(item as StoredPlay);
          if (entry && !entries.some((e) => e.session.id === entry.session.id)) {
            entries.push(entry);
          }
        }
      }
    }
    if (entries.length === 0) {
      const last = loadLastPlayed();
      if (last) entries.push(last);
    }
    return entries.slice(0, RECENT_KEEP);
  } catch {
    return [];
  }
}

export function saveLastPlayed(session: Session): void {
  const at = Date.now();
  try {
    localStorage.setItem(LAST_SESSION_KEY, JSON.stringify({ id: session.id, at }));
  } catch {
    // Storage unavailable; "Continue" just won't appear.
  }
  try {
    const previous = loadRecentlyPlayed().filter((e) => e.session.id !== session.id);
    const next = [{ id: session.id, at }, ...previous.map((e) => ({
      id: e.session.id,
      at: e.playedAt?.getTime(),
    }))].slice(0, RECENT_KEEP);
    localStorage.setItem(RECENT_SESSIONS_KEY, JSON.stringify(next));
  } catch {
    // Recently played list optional.
  }
}

// "today", "yesterday", "3 days ago", or a date.
export function playedAgo(date: Date, now = new Date()): string {
  const startOf = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
  const days = Math.round((startOf(now) - startOf(date)) / 86_400_000);
  if (days <= 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 7) return `${days} days ago`;
  return `on ${date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}`;
}
