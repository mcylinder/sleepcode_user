import type { Metadata } from 'next';
import Link from 'next/link';
import { notFound } from 'next/navigation';
import {
  SESSIONS,
  findSession,
  needsMembership,
  sessionLabel,
  sessionSubtitle,
} from '@/lib/catalog';
import { loadSessionScript, transcriptIntro } from '@/lib/sessionScript';
import { pageMeta } from '@/lib/site';
import PlayLink from '@/components/ui/PlayLink';

export const revalidate = 3600;

export function generateStaticParams() {
  return SESSIONS.map((session) => ({ id: session.id }));
}

export async function generateMetadata({
  params,
}: {
  params: Promise<{ id: string }>;
}): Promise<Metadata> {
  const session = findSession((await params).id);
  if (!session) return {};
  const title = `${sessionLabel(session)} · Transcript`;
  return pageMeta(title, transcriptIntro(session));
}

const num = (n: number) => String(n).padStart(2, '0');

export default async function SessionTranscriptPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const session = findSession((await params).id);
  if (!session) notFound();

  const script = await loadSessionScript(session);

  return (
    <div className="sc-px mx-auto flex w-full max-w-[720px] flex-col gap-8 pb-[var(--pad-section)] pt-[clamp(28px,5vw,72px)]">
      <div className="flex flex-col gap-3">
        <span className="sc-eyebrow">{sessionSubtitle(session)}</span>
        <h1 className="sc-h-page">{session.title}</h1>
        <p className="sc-lead">{transcriptIntro(session)}</p>
      </div>

      <div className="flex flex-wrap gap-4">
        {needsMembership(session) ? (
          <Link href="/pricing" className="sc-btn">
            Unlock with SleepCode+
          </Link>
        ) : (
          <PlayLink session={session} className="sc-btn">
            Hear this session
          </PlayLink>
        )}
        <Link href="/application" className="sc-btn-outline">
          Library
        </Link>
      </div>

      {script.kind === 'ready' ? (
        <ol className="flex flex-col">
          {script.concepts.map((concept, i) => (
            <li
              key={concept.id}
              className="grid grid-cols-[30px_1fr] gap-[14px] border-t border-hairline py-[18px]"
            >
              <span className="pt-[3px] font-mono text-[12px] text-ink-muted">{num(i + 1)}</span>
              <div className="flex flex-col gap-[6px]">
                {concept.title && (
                  <span className="text-[13px] font-semibold text-ink-muted">{concept.title}</span>
                )}
                {concept.lines.map((line, j) => (
                  <p key={j} className="text-[17px] leading-[1.55] text-ink">
                    {line}
                  </p>
                ))}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p className="border-t border-hairline py-[18px] text-[15px] text-ink-muted">
          {script.kind === 'empty'
            ? 'The transcript for this session will appear here soon.'
            : 'This transcript couldn\u2019t be loaded right now.'}
        </p>
      )}
    </div>
  );
}
